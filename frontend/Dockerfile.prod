# Production image: build the frontend once, serve it with Caddy (HTTPS, /api proxy).
# The Caddyfile is mounted from deploy/Caddyfile (see docker-compose.prod.yml).
FROM node:24-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM caddy:2.10.2-alpine
COPY --from=build /app/dist /srv
