# Production settings. On the server: cp deploy/env.production.example .env, fill in the
# blanks, then `make secrets prod-secrets` to generate every password and token.
# Never commit .env.

# --- Public address ---
# The site's address, e.g. watchdog.example.dev (its DNS A record points at this server)
DOMAIN=
# Let's Encrypt sends certificate expiry notices here
ACME_EMAIL=

# --- Database (POSTGRES_PASSWORD: generated by make prod-secrets) ---
POSTGRES_USER=watchdog
POSTGRES_DB=watchdog
POSTGRES_PASSWORD=

# --- Models: the server has no GPU, so everything runs on Groq's free tier ---
GROQ_API_KEY=
LLM_DEFAULT_MODEL=groq:openai/gpt-oss-120b
LLM_LIGHT_MODEL=groq:openai/gpt-oss-20b
LLM_MODELS={}

# --- Visitors and limits (defaults shown; sized for Groq's 200k tokens/day/model) ---
ANONYMOUS_VISITORS=true
# RATE_LIMIT_INVESTIGATIONS_PER_USER_HOUR=4
# RATE_LIMIT_INVESTIGATIONS_PER_DAY=12
# RATE_LIMIT_QUESTIONS_PER_USER_HOUR=20
# RATE_LIMIT_QUESTIONS_PER_DAY=80
# WATCH_AUTO_INVESTIGATE=critical

# --- Accounts (make prod-seed creates them; passwords generated by make secrets) ---
ADMIN_EMAIL=admin@watchdog.local
ADMIN_PASSWORD=
DEMO_PASSWORD=

# --- Internal tokens (generated by make secrets) ---
OPERATIONS_MCP_BACKEND_TOKEN=
OPERATIONS_MCP_EXTERNAL_TOKEN=
ANALYTICS_MCP_EXTERNAL_TOKEN=
KNOWLEDGE_MCP_EXTERNAL_TOKEN=
ENTERPRISE_API_KEY=
