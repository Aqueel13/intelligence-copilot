# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=watchdog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=watchdog

# Used when running the backend outside Docker (e.g. `uv run pytest`).
DATABASE_URL=postgresql+psycopg://watchdog:change-me@localhost:5432/watchdog

LOG_LEVEL=INFO

# --- Domain packs ---
# The default pack, and every pack the app serves (the UI switches between them).
# DOMAIN_PACK=insurance_claims
# DOMAIN_PACKS=insurance_claims,procure_to_pay

# --- LLM gateway ---
# Models are "provider:model" with provider in {ollama, groq, gemini}.
LLM_DEFAULT_MODEL=ollama:qwen2.5:7b
# Optional per-role overrides as JSON, e.g. {"answer": "groq:openai/gpt-oss-120b"}
LLM_MODELS={}
# Free-tier keys (optional; only needed for groq:/gemini: models)
GROQ_API_KEY=
GEMINI_API_KEY=
# Rate limits on requests that spend tokens (0 = none). Cache hits, showcase replays and
# admins are not limited. Per person per rolling hour / for everyone per rolling day.
# RATE_LIMIT_INVESTIGATIONS_PER_USER_HOUR=4
# RATE_LIMIT_INVESTIGATIONS_PER_DAY=12
# RATE_LIMIT_QUESTIONS_PER_USER_HOUR=20
# RATE_LIMIT_QUESTIONS_PER_DAY=80
# Automatic triage of new alerts: off | critical | all (the daily investigation budget applies)
# WATCH_AUTO_INVESTIGATE=critical
# Visitors who are not signed in can read every screen and replay showcase runs; signing in
# (accounts an admin created) is needed to run anything. false = sign-in required for all.
# ANONYMOUS_VISITORS=true
# GitHub sign-in (optional): an OAuth app whose callback is
# http://localhost:5173/api/auth/github/callback. It signs in accounts an admin created only.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ADMIN_GITHUB_LOGIN=        # your GitHub user name: sign in as the admin with GitHub
# Docker bridge address the Ollama relay listens on (`ip -4 addr show docker0`)
DOCKER_BRIDGE_IP=172.17.0.1

# --- Actions (M5): generate real values with `make secrets` ---
OPERATIONS_MCP_BACKEND_TOKEN=
OPERATIONS_MCP_EXTERNAL_TOKEN=
ANALYTICS_MCP_EXTERNAL_TOKEN=
KNOWLEDGE_MCP_EXTERNAL_TOKEN=
ENTERPRISE_API_KEY=
